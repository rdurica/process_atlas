{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build && vite build --ssr",
        "dev": "vite",
        "lint": "eslint resources/js --ext .ts,.tsx",
        "lint:fix": "eslint resources/js --ext .ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\"",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:report": "playwright show-report"
    },
    "lint-staged": {
        "resources/js/**/*.{ts,tsx}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@headlessui/react": "^2.2.4",
        "@inertiajs/react": "^2.2.15",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tanstack/react-query-devtools": "^5.100.9",
        "@types/node": "^22.15.17",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitejs/plugin-react": "^5.0.4",
        "autoprefixer": "^10.4.21",
        "axios": "^1.12.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.22.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.14.0",
        "laravel-vite-plugin": "^3.0.1",
        "lint-staged": "^15.5.0",
        "postcss": "^8.5.6",
        "prettier": "^3.5.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^3.4.18",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.22.0",
        "vite": "^8.0.8"
    },
    "dependencies": {
        "@fontsource/geist-mono": "^5.2.7",
        "@fontsource/geist-sans": "^5.2.5",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "^5.100.9",
        "@xyflow/react": "^12.8.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "geist": "^1.7.0",
        "lucide-react": "^1.14.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
