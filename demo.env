APP_NAME=ProcessAtlas
APP_ENV=production
APP_KEY=CHANGE-ME
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=process_atlas
DB_USERNAME=process_atlas
DB_PASSWORD=process_atlas

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_TTL_PUBLISHED_WORKFLOW=3600

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=localhost:8080

VITE_APP_NAME="${APP_NAME}"
